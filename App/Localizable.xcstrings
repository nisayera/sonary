    "Sonary": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonary"
          }
        }
      }
    },
    "Sonary lives in your menu bar. Every feature is a module you can turn on or off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonary lebt in deiner Menüleiste. Jede Funktion ist ein Modul, das du ein- oder ausschalten kannst."
          }
        }
      }
    },
    "Sonary needs %@ for this module. Allow it under System Settings → Privacy & Security, then turn the module on again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonary braucht für dieses Modul %@. Erlaube es unter Systemeinstellungen → Datenschutz & Sicherheit und schalte das Modul dann wieder ein."
          }
        }
      }
    },
    "Sonary updates itself from its GitHub releases.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonary aktualisiert sich selbst über seine GitHub-Releases."
          }
        }
      }
    },
    "Source code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quellcode"
          }
        }
      }
    },
    "Startup": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        }
      }
    },
    "Super Key: one key becomes ⌃⌥⇧⌘ while held and runs an action when tapped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Super-Taste: Eine Taste wird gehalten zu ⌃⌥⇧⌘ und löst beim Antippen eine Aktion aus."
          }
        }
      }
    },
    "Switch speakers and microphones, volume, microphone mute on ⌃⌥M and keep awake.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautsprecher und Mikrofone wechseln, Lautstärke, Mikrofon stumm per ⌃⌥M und Wachhalten."
          }
        }
      }
    },
    "System": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System"
          }
        }
      }
    },
