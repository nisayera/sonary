        }
      }
    },
    "Welcome to Sonary": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei Sonary"
          }
        }
      }
    },
    "Welcome window": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommensfenster"
          }
        }
      }
    },
    "What each permission does and what in Sonary uses it. Sonary asks only when you turn on something that needs it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wofür jede Berechtigung da ist und was in Sonary sie braucht. Sonary fragt erst, wenn du etwas einschaltest, das sie braucht."
          }
        }
      }
    },
    "Window layouts on ⌃⌥ shortcuts and protection against quitting apps by accident.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fensteranordnung per ⌃⌥-Kürzel und Schutz vor versehentlichem Beenden."
          }
