    "How Sonary starts and behaves.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie Sonary startet und sich verhält."
          }
        }
      }
    },
    "How much of the desktop shows through.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel vom Schreibtisch durchscheint."
          }
        }
      }
    },
    "Input Monitoring": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabeüberwachung"
          }
        }
      }
    },
    "Introduction": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einführung"
          }
        }
      }
    },
    "Lets Sonary capture the screen and show window previews.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit nimmt Sonary den Bildschirm auf und zeigt Fenstervorschauen."
          }
        }
      }
    },
    "Lets Sonary control Music, Spotify, Finder and System Events. macOS asks once for each app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit steuert Sonary Musik, Spotify, Finder und die Systemereignisse. macOS fragt für jede App einmal."
          }
        }
      }
    },
    "Lets Sonary react to clicks and keys, and move windows.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit reagiert Sonary auf Klicks und Tasten und verschiebt Fenster."
          }
        }
      }
    },
    "Lets Sonary show how loud the microphone is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit zeigt Sonary, wie laut das Mikrofon ist."
          }
        }
      }
    },
    "Lets Sonary show the camera image.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit zeigt Sonary das Kamerabild."
          }
        }
      }
    },
    "Lets Sonary show today's events.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit zeigt Sonary die heutigen Termine."
          }
        }
      }
    },
    "Lets Sonary warn you about the alerts you turned on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit warnt Sonary dich bei den Warnungen, die du eingeschaltet hast."
          }
        }
      }
    },
    "License": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lizenz"
          }
        }
      }
    },
    "Linear or smooth scrolling, pointer acceleration, extra buttons, click filter and app exceptions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineares oder weiches Scrollen, Zeigerbeschleunigung, Zusatztasten, Klick-Filter und Ausnahmen pro App."
