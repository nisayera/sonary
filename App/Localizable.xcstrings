{
  "sourceLanguage": "en",
  "strings": {
    "%lld of %lld modules on": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld von %lld Modulen an"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen"
          }
        }
      }
    },
    "Add ⌃, ⌥, ⇧ or ⌘ — a plain key would be caught everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ⌃, ⌥, ⇧ oder ⌘ hinzu – eine einzelne Taste würde überall abgefangen."
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben"
          }
        }
      }
    },
    "Already used by %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird schon von %@ benutzt."
          }
        }
      }
    },
    "An island at the notch with music, calendar, timer, downloads and accessory batteries.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Insel am Notch mit Musik, Kalender, Timer, Downloads und Zubehör-Akkus."
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheinungsbild"
          }
        }
      }
    },
    "Asked for each app": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird pro App gefragt"
          }
        }
      }
    },
    "Asked for when you turn the module on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird angefragt, wenn du das Modul einschaltest."
          }
        }
      }
    },
    "Automation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation"
          }
        }
      }
    },
    "Back to the shortcut Sonary ships with": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück zum Kürzel, das Sonary mitbringt"
          }
        }
      }
    },
    "Brightness for every display, with shortcuts and dimming for displays without hardware control.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helligkeit für jedes Display, mit Kurzbefehlen und Abdunkeln für Displays ohne Hardware-Steuerung."
          }
        }
      }
    },
    "CPU, GPU, memory, network, disk, battery and temperatures, with history and alerts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, GPU, Arbeitsspeicher, Netzwerk, Festplatte, Akku und Temperaturen, mit Verlauf und Warnungen."
          }
        }
      }
    },
    "Calendars": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender"
          }
        }
      }
    },
    "Camera": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera"
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Updates suchen …"
          }
        }
      }
    },
    "Check for updates automatically": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch nach Updates suchen"
          }
        }
      }
    },
    "Cleaner, uninstaller, quit and force quit, port manager and Homebrew updates.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufräumen, Deinstallieren, Beenden und Sofort-Beenden, Port-Manager und Homebrew-Updates."
          }
        }
      }
    },
    "Clear search": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche löschen"
          }
        }
      }
    },
    "Click a shortcut to record a new one. Press ⌫ to switch it off, ⎋ to keep it as it is.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf ein Kürzel, um ein neues aufzunehmen. ⌫ schaltet es aus, ⎋ behält es."
          }
        }
      }
    },
    "Clipboard history, clean links, plain-text paste, a file shelf and Finder helpers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenablage-Verlauf, saubere Links, Einsetzen als reiner Text, eine Datei-Ablage und Finder-Helfer."
          }
        }
      }
    },
    "Command bar, text from screen, color picker, screenshots, scratchpad and snippets.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehlsleiste, Text vom Bildschirm, Farbaufnahme, Bildschirmfotos, Notizblock und Textbausteine."
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    },
    "Essentials": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grundlagen"
          }
        }
      }
    },
    "Explains Sonary and the permissions of your modules.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erklärt Sonary und die Berechtigungen deiner Module."
          }
        }
      }
    },
