      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen"
          }
        }
      }
    },
    "License": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lizenz"
          }
        }
      }
    },
    "CPU, GPU, memory, network, disk, battery and temperatures, with history and alerts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, GPU, Arbeitsspeicher, Netzwerk, Festplatte, Akku und Temperaturen, mit Verlauf und Warnungen."
          }
        }
      }
    },
    "Linear or smooth scrolling, pointer acceleration, extra buttons, click filter and app exceptions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineares oder weiches Scrollen, Zeigerbeschleunigung, Zusatztasten, Klick-Filter und Ausnahmen pro App."
          }
        }
      }
    },
    "An island at the notch with music, calendar, timer, downloads and accessory batteries.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Insel am Notch mit Musik, Kalender, Timer, Downloads und Zubehör-Akkus."
          }
        }
      }
    },
    "Clipboard history, clean links, plain-text paste, a file shelf and Finder helpers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenablage-Verlauf, saubere Links, Einsetzen als reiner Text, eine Datei-Ablage und Finder-Helfer."
          }
        }
      }
    },
    "Cleaner, uninstaller, quit and force quit, port manager and Homebrew updates.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufräumen, Deinstallieren, Beenden und Sofort-Beenden, Port-Manager und Homebrew-Updates."
          }
        }
      }
    },
    "Window layouts on ⌃⌥ shortcuts and protection against quitting apps by accident.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fensteranordnung per ⌃⌥-Kürzel und Schutz vor versehentlichem Beenden."
          }
        }
      }
    }
  },
  "version": "1.0"
}