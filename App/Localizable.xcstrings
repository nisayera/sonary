    "Welcome to Sonary": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei Sonary"
          }
        }
      }
    },
    "Sonary lives in your menu bar. Every feature is a module you can turn on or off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonary lebt in deiner Menüleiste. Jede Funktion ist ein Modul, das du ein- oder ausschalten kannst."
          }
        }
      }
    },
    "No permissions are needed right now. Modules ask for access only when you turn them on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuell sind keine Berechtigungen nötig. Module fragen erst nach Zugriff, wenn du sie einschaltest."
          }
        }
      }
    },
