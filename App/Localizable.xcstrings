      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalender in der Notch"
          }
        }
      }
    },
    "The camera in the notch, the camera preview": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera in der Notch, die Kameravorschau"
          }
        }
      }
    },
    "The microphone level in the sound panel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonpegel im Ton-Bereich"
          }
        }
      }
    },
    "Turn a module on to see the shortcuts it offers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte ein Modul ein, um seine Kürzel zu sehen."
          }
        }
      }
    },
    "Turn all off": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle ausschalten"
          }
        }
      }
    },
    "Turn modules on in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Module in den Einstellungen ein."
          }
        }
      }
    },
    "Turn on a module to see it here as its own tab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte ein Modul ein, um es hier als eigenen Tab zu sehen."
          }
        }
      }
    },
    "Turn on only what you use. A module that is off does not load, run in the background or ask for permissions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte nur ein, was du brauchst. Ein ausgeschaltetes Modul lädt nicht, läuft nicht im Hintergrund und fragt nach keiner Berechtigung."
          }
        }
      }
    },
    "Updates": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates"
          }
        }
      }
    },
