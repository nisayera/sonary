    "Explains Sonary and the permissions of your modules.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erklärt Sonary und die Berechtigungen deiner Module."
          }
        }
      }
    },
    "Sonary updates itself from its GitHub releases.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonary aktualisiert sich selbst über seine GitHub-Releases."
          }
        }
      }
    },
    "Your Mac's menu bar toolbox. Open source, modular, native for macOS 26.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Werkzeugkasten für deine Mac-Menüleiste. Quelloffen, modular, nativ für macOS 26."
          }
        }
      }
    },
    "Source code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quellcode"
          }
        }
      }
    },
