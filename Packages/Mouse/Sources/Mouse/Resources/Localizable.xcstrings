    "Press the trackpad with three fingers down to middle-click, for opening links in a new tab.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke das Trackpad mit drei Fingern, um mittlere Maustaste auszulösen – etwa um Links in einem neuen Tab zu öffnen."
          }
        }
      }
    },
