    },
    "Trackpads and Magic Mouse are not changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpads und Magic Mouse bleiben unverändert."
          }
        }
      }
    },
    "Turn Sonary's mouse changes off while one of these apps is in front.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mausänderungen von Sonary ausschalten, solange eine dieser Apps vorne ist."
          }
        }
      }
    },
