            "state": "translated",
            "value": "Glättung"
          }
        }
      }
    },
    "Sonary could not watch mouse events. Allow Sonary under Privacy & Security > Accessibility.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonary kann Mausereignisse nicht überwachen. Erlaube Sonary unter Datenschutz & Sicherheit > Bedienungshilfen."
          }
        }
      }
    },
    "The original setting is restored when the module is turned off or Sonary quits.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ursprüngliche Einstellung wird wiederhergestellt, wenn das Modul ausgeschaltet oder Sonary beendet wird."
          }
        }
      }
    },
    "Three-finger press is a middle click": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreifinger-Druck ist ein Mittelklick"
          }
        }
      }
    },
