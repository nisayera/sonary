      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Displays"
          }
        }
      }
    },
    "Brighter": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heller"
          }
        }
      }
    },
    "Brighter than white, which uses more power.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heller als Weiß, braucht mehr Strom."
          }
        }
      }
    },
    "Brightness": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helligkeit"
          }
        }
      }
    },
    "Brightness with ⌃⌥⇧↑ and ⌃⌥⇧↓": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helligkeit mit ⌃⌥⇧↑ und ⌃⌥⇧↓"
          }
        }
      }
    },
    "Changes the display the pointer is on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert das Display, auf dem der Zeiger steht."
          }
        }
      }
    },
    "Darker": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkler"
          }
        }
      }
    },
