          "stringUnit": {
            "state": "translated",
            "value": "Anzeige"
          }
        }
      }
    },
    "Displays": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays"
          }
        }
      }
    },
    "Energy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Energie"
          }
        }
      }
    },
    "Extra brightness": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra Helligkeit"
          }
        }
      }
    },
    "Finer steps for the shortcuts, like ⌥⇧ with the brightness keys.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feinere Schritte für die Kurzbefehle, wie ⌥⇧ mit den Helligkeitstasten."
          }
        }
      }
    },
    "Go darker than the display's minimum": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkler als das Minimum des Displays"
          }
        }
      }
    },
    "Hardware brightness": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardware-Helligkeit"
          }
        }
      }
    },
    "Lift": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufheben"
          }
        }
      }
    },
    "No display found.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Display gefunden."
          }
        }
      }
    },
    "No hardware control: Sonary dims it with an overlay instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Hardware-Steuerung: Sonary dunkelt stattdessen mit einer Ebene ab."
          }
        }
      }
    },
    "No pictures found. Add a folder with your own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Bilder gefunden. Füge einen Ordner mit eigenen hinzu."
          }
        }
      }
    },
    "Shortcuts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle"
          }
        }
      }
    },
    "Step size": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrittweite"
          }
        }
      }
    },
    "Stepping down past the lowest brightness keeps going with an overlay. Sonary lifts it again on restart.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter der niedrigsten Helligkeit dunkelt Sonary mit einer Abdeckung weiter ab. Nach einem Neustart ist sie wieder weg."
          }
        }
      }
    },
    "Switched back on when it wakes, and only if Sonary switched it off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim Aufwachen wieder eingeschaltet, und nur wenn Sonary es ausgeschaltet hat."
          }
        }
      }
    },
    "These displays can go brighter than ordinary white. Sonary asks them to open that headroom, which is how XDR panels reach their peak.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bildschirme können heller als normales Weiß. Sonary fordert diesen Spielraum an – so erreichen XDR-Panels ihre Spitzenhelligkeit."
          }
        }
      }
    },
    "Turn Bluetooth off while the Mac sleeps": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ausschalten, während der Mac schläft"
          }
        }
      }
    },
    "Wallpaper": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibtischhintergrund"
          }
        }
      }
    },
    "dimmed by Sonary": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "von Sonary abgedunkelt"
          }
        }
      }
    },
    "macOS did not take that picture.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat dieses Bild nicht übernommen."
          }
        }
      }
    }
  },
  "version": "1.0"
}