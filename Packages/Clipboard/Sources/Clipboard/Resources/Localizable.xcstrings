{
  "sourceLanguage": "en",
  "strings": {
    "%lld characters": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Zeichen"
          }
        }
      }
    },
    "%lld files moved.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Dateien verschoben."
          }
        }
      }
    },
    "%lld files ready to move. Paste them in another folder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Dateien bereit zum Verschieben. Füge sie in einem anderen Ordner ein."
          }
        }
      }
    },
    "Allow Sonary to control Finder in System Settings > Privacy & Security > Automation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Sonary unter Systemeinstellungen > Datenschutz & Sicherheit > Automation, den Finder zu steuern."
          }
        }
      }
    },
    "Clean link copied.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigter Link kopiert."
          }
        }
      }
    },
    "Clean links": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links bereinigen"
          }
        }
      }
    },
    "Clear history (keeps pinned)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf leeren (Angeheftetes bleibt)"
          }
        }
      }
    },
    "Clear when the Mac goes to sleep": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ruhezustand leeren"
          }
        }
      }
    },
    "Clear when the screen locks": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Sperren des Bildschirms leeren"
          }
        }
      }
    },
    "Clearing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeren"
          }
        }
      }
    },
    "Clipboard": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenablage"
          }
        }
      }
    },
    "Clipboard history on ⌃⌥V": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenablage-Verlauf auf ⌃⌥V"
          }
        }
      }
    },
    "Clipboard quick panel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnellpanel für die Zwischenablage"
          }
        }
      }
    },
    "Copied images are kept as files and opened again from the list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierte Bilder werden als Dateien abgelegt und aus der Liste wieder geöffnet."
          }
        }
      }
    },
    "Copied text appears here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierter Text erscheint hier."
          }
        }
      }
    },
    "Copy again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut kopieren"
          }
        }
      }
    },
    "Copy clean": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigt kopieren"
          }
        }
      }
    },
    "Copy path of selected items": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfad der ausgewählten Objekte kopieren"
          }
        }
      }
    },
    "Copying and pasting": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieren und Einsetzen"
          }
        }
      }
    },
    "Could not save the image there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild konnte dort nicht gesichert werden."
          }
        }
      }
    },
    "Cut the selected files": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Dateien ausschneiden"
          }
        }
      }
    },
    "Drag files out of the shelf to move or copy them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe Dateien aus der Ablage, um sie zu verschieben oder zu kopieren."
          }
        }
      }
    },
    "Drop files here to keep them handy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien hier ablegen, um sie griffbereit zu haben"
          }
        }
      }
    },
    "Files": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien"
          }
        }
      }
    },
    "Finder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder"
          }
        }
      }
    },
    "Forget entries after %lld minutes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge nach %lld Minuten vergessen"
          }
        }
      }
    },
    "History": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf"
          }
        }
      }
    },
    "Images": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder"
          }
        }
      }
    },
    "Keep entries until I clear them": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge behalten, bis ich sie lösche"
          }
        }
      }
    },
    "Keep the last %lld copies": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten %lld Kopien behalten"
          }
        }
      }
    },
    "Move them into this folder": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesen Ordner verschieben"
          }
        }
      }
    },
    "New text file in current folder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Textdatei im aktuellen Ordner"
          }
        }
      }
    },
    "Nothing copied yet, or nothing matches.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts kopiert oder kein Treffer."
          }
        }
      }
    },
    "Nothing to remove from this one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gibt es nichts zu entfernen."
          }
        }
      }
    },
    "Nothing was cut.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts ausgeschnitten."
          }
        }
      }
    },
    "Off, the entry only goes on the clipboard. Pasting needs the Accessibility permission.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus, landet der Eintrag nur in der Zwischenablage. Zum Einfügen braucht Sonary die Bedienungshilfen."
          }
        }
      }
    },
    "Open": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen"
          }
        }
      }
    },
    "Open Terminal in current folder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal im aktuellen Ordner öffnen"
          }
        }
      }
    },
    "Open the menu panel's clipboard tab to use the file shelf and the Finder helpers. The Finder helpers ask once for permission to control Finder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ablage und die Finder-Helfer findest du im Zwischenablage-Tab des Menüs. Die Finder-Helfer fragen einmal nach der Erlaubnis, Finder zu steuern."
          }
        }
      }
    },
    "Paste a link to clean": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Link zum Bereinigen einfügen"
          }
        }
      }
    },
    "Paste as plain text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als reinen Text einsetzen"
          }
        }
      }
    },
    "Paste as plain text with ⌘⌥⇧V": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit ⌘⌥⇧V als reinen Text einsetzen"
          }
        }
      }
    },
    "Paste the entry straight away": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eintrag direkt einfügen"
          }
        }
      }
    },
    "Path copied.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfad kopiert."
          }
        }
      }
    },
    "Pin": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anheften"
          }
        }
      }
    },
    "Pinned entries always stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftete Einträge bleiben immer."
          }
        }
      }
    },
    "Pinned entries are always kept. Passwords from password managers are never recorded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftete Einträge bleiben immer. Passwörter aus Passwort-Managern werden nie gespeichert."
          }
        }
      }
    },
    "Quick panel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnellpanel"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen"
          }
        }
      }
    },
    "Removes tracking parameters such as utm_source or fbclid from copied links.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Tracking-Parameter wie utm_source oder fbclid aus kopierten Links."
          }
        }
      }
    },
    "Rename the selected file": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Datei umbenennen"
          }
        }
      }
    },
    "Return or ⌘1–9 copies, Esc closes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Return oder ⌘1–9 kopiert, Esc schließt"
          }
        }
      }
    },
    "Return or ⌘1–9 pastes, Esc closes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Return oder ⌘1–9 fügt ein, Esc schließt"
          }
        }
      }
    },
    "Save clipboard image here as PNG": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild aus der Zwischenablage hier als PNG sichern"
          }
        }
      }
    },
    "Saved %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gesichert."
          }
        }
      }
    },
    "Search": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen"
          }
        }
      }
    },
    "Search everything you copied, see each entry in full, and pick one with Return or ⌘1 to ⌘9. Change the shortcut on the Shortcuts page.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuche alles Kopierte, sieh jeden Eintrag vollständig und wähle einen mit Return oder ⌘1 bis ⌘9. Das Kürzel änderst du auf der Seite „Tastaturkürzel“."
          }
        }
      }
    },
    "Search the clipboard": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenablage durchsuchen"
          }
        }
      }
    },
    "Select files in Finder first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zuerst Dateien im Finder aus."
          }
        }
      }
    },
    "Shelf": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ablage"
          }
        }
      }
    },
    "Shelf and Finder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ablage und Finder"
          }
        }
      }
    },
    "Strips formatting, pastes, and puts the original contents back. Needs the Accessibility permission.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt die Formatierung, setzt ein und stellt den ursprünglichen Inhalt danach wieder her. Braucht die Berechtigung Bedienungshilfen."
          }
        }
      }
    },
    "The files could not be moved there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien konnten dort nicht abgelegt werden."
          }
        }
      }
    },
    "There is no image on the clipboard.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Zwischenablage ist kein Bild."
          }
        }
      }
    },
    "Unpin": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösen"
          }
        }
      }
    },
    "Untitled": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Titel"
          }
        }
      }
    },
    "What is recorded": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was gespeichert wird"
          }
        }
      }
    }
  },
  "version": "1.0"
}