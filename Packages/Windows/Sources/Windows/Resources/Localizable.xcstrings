{
  "sourceLanguage": "en",
  "strings": {
    "A click on a running app's icon": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Klick auf das Symbol einer laufenden App"
          }
        }
      }
    },
    "A window comes forward when the pointer rests on it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fenster kommt nach vorn, wenn der Zeiger darauf ruht."
          }
        }
      }
    },
    "Add app…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App hinzufügen …"
          }
        }
      }
    },
    "All apps": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Apps"
          }
        }
      }
    },
    "Asks for the Screen Recording permission the first time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt beim ersten Mal nach der Berechtigung Bildschirmaufnahme."
          }
        }
      }
    },
    "Bottom half": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Untere Hälfte"
          }
        }
      }
    },
    "Bottom left quarter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten links"
          }
        }
      }
    },
    "Bottom right quarter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten rechts"
          }
        }
      }
    },
    "Center": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zentrieren"
          }
        }
      }
    },
    "Center third": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittleres Drittel"
          }
        }
      }
    },
    "Closing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        }
      }
    },
    "Confirm by": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen durch"
          }
        }
      }
    },
    "Cycle through its windows": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch ihre Fenster blättern"
          }
        }
      }
    },
    "Dock": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock"
          }
        }
      }
    },
    "Drag a window against an edge or a corner and let go.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh ein Fenster an einen Rand oder in eine Ecke und lass los."
          }
        }
      }
    },
    "Dragging": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen"
          }
        }
      }
    },
    "Every app is protected. Add apps to protect only those.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Apps sind geschützt. Füge Apps hinzu, um nur diese zu schützen."
          }
        }
      }
    },
    "Fill the screen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirm füllen"
          }
        }
      }
    },
    "Finder and menu bar apps are never quit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Finder und Menüleisten-Apps werden nie beendet."
          }
        }
      }
    },
    "Focus follows the pointer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus folgt dem Zeiger"
          }
        }
      }
    },
    "Hold ⌃⌘ and drag": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌘ halten und ziehen"
          }
        }
      }
    },
    "Hold ⌘Q to quit %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Q halten, um %@ zu beenden"
          }
        }
      }
    },
    "Hold ⌘W to close this window": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘W halten, um dieses Fenster zu schließen"
          }
        }
      }
    },
    "Holding the keys": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten halten"
          }
        }
      }
    },
    "Keep the Spaces in the order I put them": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaces in meiner Reihenfolge behalten"
          }
        }
      }
    },
    "Keyboard shortcuts for window layouts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenkürzel für die Fensteranordnung"
          }
        }
      }
    },
    "Leave it to macOS": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS überlassen"
          }
        }
      }
    },
    "Left half": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linke Hälfte"
          }
        }
      }
    },
    "Left third": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkes Drittel"
          }
        }
      }
    },
    "Lists every open window with search, and brings the one you pick to the front.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet jedes offene Fenster mit Suche und holt das gewählte nach vorn."
          }
        }
      }
    },
    "Maximize": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximieren"
          }
        }
      }
    },
    "Minimize all its windows": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle ihre Fenster minimieren"
          }
        }
      }
    },
    "Move": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegen"
          }
        }
      }
    },
    "Move and resize": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegen und Größe ändern"
          }
        }
      }
    },
    "Move to the next display": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf das nächste Display"
          }
        }
      }
    },
    "Move with the keyboard held": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit gehaltener Tastatur bewegen"
          }
        }
      }
    },
    "Moves and resizes the front window.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebt das vorderste Fenster und ändert seine Größe."
          }
        }
      }
    },
    "Moves the window under the pointer from anywhere in it, instead of hunting for the title bar. Dragging with the right button resizes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegt das Fenster unter dem Zeiger von jeder Stelle aus, statt die Titelleiste zu suchen. Ziehen mit der rechten Taste ändert die Größe."
          }
        }
      }
    },
    "Off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus"
          }
        }
      }
    },
    "Only these apps are protected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur diese Apps sind geschützt."
          }
        }
      }
    },
    "Press ⌘Q again to quit %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke erneut ⌘Q, um %@ zu beenden"
          }
        }
      }
    },
    "Press ⌘Q twice to quit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Q zweimal drücken zum Beenden"
          }
        }
      }
    },
    "Press ⌘W again to close this window": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke erneut ⌘W, um dieses Fenster zu schließen"
          }
        }
      }
    },
    "Press ⌘W twice to close a window": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘W zweimal drücken zum Schließen"
          }
        }
      }
    },
    "Pressing twice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweimal drücken"
          }
        }
      }
    },
    "Put the last window back": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letztes Fenster zurücksetzen"
          }
        }
      }
    },
    "Put the window back": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster zurücksetzen"
          }
        }
      }
    },
    "Quit an app when its last window closes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App beenden, wenn ihr letztes Fenster schließt"
          }
        }
      }
    },
    "Quit protection": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden-Schutz"
          }
        }
      }
    },
    "Remove app": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App entfernen"
          }
        }
      }
    },
    "Resize": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größe ändern"
          }
        }
      }
    },
    "Right half": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechte Hälfte"
          }
        }
      }
    },
    "Right third": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtes Drittel"
          }
        }
      }
    },
    "Search windows": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster suchen"
          }
        }
      }
    },
    "Show a picture of each window": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild jedes Fensters zeigen"
          }
        }
      }
    },
    "Show all its windows": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle ihre Fenster zeigen"
          }
        }
      }
    },
    "Show it now": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt anzeigen"
          }
        }
      }
    },
    "Shows that app's windows from every Space, which the Dock itself will not.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Fenster der App aus allen Spaces – das Dock selbst tut das nicht."
          }
        }
      }
    },
    "Snap windows at the screen edges": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster an den Bildschirmrändern einrasten"
          }
        }
      }
    },
    "Sonary adds this after the Dock has had the click, so the Dock keeps working.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonary ergänzt das, nachdem das Dock den Klick hatte – das Dock funktioniert also weiter."
          }
        }
      }
    },
    "Spaces": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaces"
          }
        }
      }
    },
    "Stops apps from closing by accident. Finder is never affected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass Apps versehentlich beendet werden. Der Finder ist nie betroffen."
          }
        }
      }
    },
    "Top half": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obere Hälfte"
          }
        }
      }
    },
    "Top left quarter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben links"
          }
        }
      }
    },
    "Top right quarter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben rechts"
          }
        }
      }
    },
    "Window layouts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fensteranordnung"
          }
        }
      }
    },
    "Window previews when the pointer rests on an icon": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenstervorschauen, wenn der Zeiger auf einem Symbol ruht"
          }
        }
      }
    },
    "Window switcher": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fensterwechsler"
          }
        }
      }
    },
    "Window switcher on ⌃⌥Tab": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fensterwechsler mit ⌃⌥Tab"
          }
        }
      }
    },
    "Windows": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster"
          }
        }
      }
    },
    "macOS otherwise rearranges them by most recent use. Changing this restarts the Dock, which blinks once.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS sortiert sie sonst nach letzter Nutzung. Die Änderung startet das Dock neu, es blinkt einmal."
          }
        }
      }
    }
  },
  "version": "1.0"
}