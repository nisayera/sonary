      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben links"
          }
        }
      }
    },
    "Top left sixth": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberes linkes Sechstel"
          }
        }
      }
    },
    "Top right quarter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben rechts"
          }
        }
      }
    },
    "Top right sixth": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberes rechtes Sechstel"
          }
        }
      }
    },
    "Window layouts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fensteranordnung"
          }
        }
      }
    },
    "Window previews when the pointer rests on an icon": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenstervorschauen, wenn der Zeiger auf einem Symbol ruht"
          }
        }
      }
    },
    "Window switcher": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fensterwechsler"
          }
        }
      }
    },
    "Window switcher on ⌃⌥Tab": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fensterwechsler mit ⌃⌥Tab"
          }
        }
      }
    },
    "Windows": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster"
          }
        }
      }
    },
    "macOS otherwise rearranges them by most recent use. Changing this restarts the Dock, which blinks once.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS sortiert sie sonst nach letzter Nutzung. Die Änderung startet das Dock neu, es blinkt einmal."
          }
        }
      }
    }
  },
  "version": "1.0"
}