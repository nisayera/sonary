        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen"
          }
        }
      }
    },
    "Screenshots and text from screen ask once for the Screen Recording permission.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmfotos und Text vom Bildschirm fragen einmal nach der Berechtigung Bildschirmaufnahme."
