    },
    "Insert a snippet by": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baustein einfügen durch"
          }
        }
      }
    },
    "It can also open on a shortcut of its own, from the Shortcuts page; then it stays until you close it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie lässt sich auch über einen eigenen Kurzbefehl von der Kurzbefehl-Seite öffnen; dann bleibt sie, bis du sie schließt."
          }
        }
      }
    },
    "Keep from": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten von"
          }
        }
      }
