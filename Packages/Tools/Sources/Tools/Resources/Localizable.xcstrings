      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheinungsbild"
          }
        }
      }
    },
    "Apps, files and keyboard shortcuts get wedges after the actions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, Dateien und Tastenkurzbefehle bekommen Segmente nach den Aktionen."
          }
        }
      }
    },
