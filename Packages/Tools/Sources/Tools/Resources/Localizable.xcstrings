          "stringUnit": {
            "state": "translated",
            "value": "App hinzufügen …"
          }
        }
      }
    },
    "Add snippet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textbaustein hinzufügen"
          }
        }
      }
    },
    "Add to Favourites": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Favoriten hinzufügen"
          }
        }
      }
    },
    "All apps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Apps"
          }
        }
      }
    },
    "Allow Sonary to record the screen in System Settings > Privacy & Security.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Sonary die Bildschirmaufnahme in Systemeinstellungen > Datenschutz & Sicherheit."
          }
        }
      }
    },
    "Also block the system keys": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch die Systemtasten sperren"
          }
        }
      }
    },
    "App windows": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster der App zeigen"
          }
        }
