{
  "sourceLanguage": "en",
  "strings": {
    "%lld keyboard shortcuts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Tastenkurzbefehle"
          }
        }
      }
    },
    "0 as the end keeps everything to the end. The trimmed copy lands next to the original.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 als Ende behält alles bis zum Schluss. Die gekürzte Kopie landet neben dem Original."
          }
        }
      }
    },
    "A small palette of your favourite tools next to the pointer. Give it a shortcut on the Shortcuts page.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kleine Palette deiner Lieblingswerkzeuge neben dem Zeiger. Gib ihr auf der Kurzbefehl-Seite einen Kurzbefehl."
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen"
          }
        }
      }
    },
    "Add a file…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei hinzufügen …"
          }
        }
      }
    },
    "Add a ring": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ring hinzufügen"
          }
        }
      }
    },
