      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenkürzel"
          }
        }
      }
    },
    "⌥Space command bar, ⌃⌥T text from screen, ⌃⌥P color picker, ⌃⌥S screenshot.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥Leertaste Befehlsleiste, ⌃⌥T Text vom Bildschirm, ⌃⌥P Farbe, ⌃⌥S Bildschirmfoto."
          }
        }
      }
    },
    "Placeholders: {date}, {time} and {clipboard}.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platzhalter: {date}, {time} und {clipboard}."
          }
        }
      }
    },
