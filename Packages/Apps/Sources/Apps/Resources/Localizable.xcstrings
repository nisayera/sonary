{
  "sourceLanguage": "en",
  "strings": {
    "%@ could not be copied to the Applications folder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht in den Programme-Ordner kopiert werden."
          }
        }
      }
    },
    "%@ is in your Applications folder, and the disk image is in the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liegt jetzt in deinem Programme-Ordner, das Disk-Image im Papierkorb."
          }
        }
      }
    },
    "%@ is in your Applications folder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liegt jetzt in deinem Programme-Ordner."
          }
        }
      }
    },
    "%@ was moved to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde in den Papierkorb gelegt."
          }
        }
      }
    },
    "%@: %lld extra items, %@ in total": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld zusätzliche Objekte, insgesamt %3$@"
          }
        }
      }
    },
    "Add folder…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner hinzufügen …"
          }
        }
      }
    },
    "App caches": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Caches"
          }
        }
      }
    },
    "Apps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "Checking your apps…": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apps werden geprüft …"
          }
        }
      }
    },
    "Choose app…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App auswählen …"
          }
        }
      }
    },
    "Clean": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufräumen"
          }
        }
      }
    },
    "Clean caches and logs": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches und Protokolle aufräumen"
          }
        }
      }
    },
    "Clean caches and logs, quit or force quit apps, stop processes that block a port and update Homebrew apps from the menu panel's apps tab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Apps-Tab des Menüs räumst du Caches und Protokolle auf, beendest Apps, stoppst Prozesse, die einen Port blockieren, und aktualisierst Homebrew-Apps."
          }
        }
      }
    },
    "Cleaning moves the files to the Trash. Apps rebuild their caches when needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufräumen legt die Dateien in den Papierkorb. Apps bauen ihre Caches bei Bedarf neu auf."
          }
        }
      }
    },
    "Could not move %@ to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht in den Papierkorb gelegt werden."
          }
        }
      }
    },
    "Delete after %lld days": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %lld Tagen löschen"
          }
        }
      }
    },
    "Disk images": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk-Images"
          }
        }
      }
    },
    "Every month": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Monat"
          }
        }
      }
    },
    "Every week": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Woche"
          }
        }
      }
    },
    "Everything installed with Homebrew is up to date.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was mit Homebrew installiert ist, ist aktuell."
          }
        }
      }
    },
    "Force Quit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofort beenden"
          }
        }
      }
    },
    "Found on a mounted disk image": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem eingebundenen Image gefunden"
          }
        }
      }
    },
    "Homebrew could not upgrade %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew konnte %@ nicht aktualisieren."
          }
        }
      }
    },
    "Ignore": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorieren"
          }
        }
      }
    },
    "In the menu panel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Menü"
          }
        }
      }
    },
    "Install": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren"
          }
        }
      }
    },
    "Install Homebrew (brew.sh) to see and install updates for your apps and tools.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Homebrew (brew.sh), um Updates für deine Apps und Werkzeuge zu sehen und zu installieren."
          }
        }
      }
    },
    "Last cleaned %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt aufgeräumt %@"
          }
        }
      }
    },
    "Logs": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokolle"
          }
        }
      }
    },
    "Move the disk image to the Trash after installing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk-Image nach der Installation in den Papierkorb legen"
          }
        }
      }
    },
    "Move to Trash": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Papierkorb legen"
          }
        }
      }
    },
    "Moved %lld old files to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld alte Dateien in den Papierkorb gelegt."
          }
        }
      }
    },
    "Moves the app and its settings, caches and data from your Library to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die App und ihre Einstellungen, Caches und Daten aus deiner Library in den Papierkorb."
          }
        }
      }
    },
    "Never": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie"
          }
        }
      }
    },
    "No app is listening on a TCP port.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine App lauscht auf einem TCP-Port."
          }
        }
      }
    },
    "Open": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen"
          }
        }
      }
    },
    "Other": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonstiges"
          }
        }
      }
    },
    "Ports": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ports"
          }
        }
      }
    },
    "Quit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden"
          }
        }
      }
    },
    "Refresh": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren"
          }
        }
      }
    },
    "Remove an app completely": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine App vollständig entfernen"
          }
        }
      }
    },
    "Remove folder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner entfernen"
          }
        }
      }
    },
    "Runs in the background and moves everything to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft im Hintergrund und legt alles in den Papierkorb."
          }
        }
      }
    },
    "Scheduled cleaning": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplantes Aufräumen"
          }
        }
      }
    },
    "Some items are in use and were skipped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Objekte werden gerade benutzt und wurden übersprungen."
          }
        }
      }
    },
    "Sonary moves files out of these folders to the Trash once they are old enough. Good for a messenger's downloads.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonary legt Dateien aus diesen Ordnern in den Papierkorb, sobald sie alt genug sind. Gut für die Downloads eines Messengers."
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen"
          }
        }
      }
    },
    "This is not an app Sonary can read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App kann Sonary nicht lesen."
          }
        }
      }
    },
    "Tidy up folders": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner aufräumen"
          }
        }
      }
    },
    "Uninstaller": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deinstallation"
          }
        }
      }
    },
    "Update": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren"
          }
        }
      }
    },
    "Updates": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates"
          }
        }
      }
    },
    "When a mounted image offers one app, the panel installs it into Applications and ejects the image. With this on, the downloaded file goes too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bietet ein geöffnetes Image genau eine App an, kopiert das Panel sie in den Programme-Ordner und wirft das Image aus. Ist das hier an, landet auch die geladene Datei im Papierkorb."
          }
        }
      }
    },
    "Xcode build data": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode-Build-Daten"
          }
        }
      }
    }
  },
  "version": "1.0"
}