{
  "sourceLanguage": "en",
  "strings": {
    "Apps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps"
          }
        }
      }
    },
    "Clean": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufräumen"
          }
        }
      }
    },
    "Ports": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ports"
          }
        }
      }
    },
    "Updates": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates"
          }
        }
      }
    },
    "App caches": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Caches"
          }
        }
      }
    },
    "Logs": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokolle"
          }
        }
      }
    },
    "Xcode build data": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode-Build-Daten"
          }
        }
      }
    },
    "Other": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonstiges"
          }
        }
      }
    },
    "Cleaning moves the files to the Trash. Apps rebuild their caches when needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufräumen legt die Dateien in den Papierkorb. Apps bauen ihre Caches bei Bedarf neu auf."
          }
        }
      }
    },
    "Quit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden"
          }
        }
      }
    },
    "Force Quit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofort beenden"
          }
        }
      }
    },
    "No app is listening on a TCP port.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine App lauscht auf einem TCP-Port."
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen"
          }
        }
      }
    },
    "Refresh": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren"
          }
        }
      }
    },
    "Install Homebrew (brew.sh) to see and install updates for your apps and tools.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Homebrew (brew.sh), um Updates für deine Apps und Werkzeuge zu sehen und zu installieren."
          }
        }
      }
    },
    "Everything installed with Homebrew is up to date.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was mit Homebrew installiert ist, ist aktuell."
          }
        }
      }
    },
    "Update": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren"
          }
        }
      }
    },
    "Uninstaller": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deinstallation"
          }
        }
      }
    },
    "Remove an app completely": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine App vollständig entfernen"
          }
        }
      }
    },
    "Moves the app and its settings, caches and data from your Library to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die App und ihre Einstellungen, Caches und Daten aus deiner Library in den Papierkorb."
          }
        }
      }
    },
    "Choose app…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App auswählen …"
          }
        }
      }
    },
    "%@: %lld extra items, %@ in total": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld zusätzliche Objekte, insgesamt %3$@"
          }
        }
      }
    },
    "Move to Trash": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Papierkorb legen"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "In the menu panel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Menü"
          }
        }
      }
    },
    "Clean caches and logs, quit or force quit apps, stop processes that block a port and update Homebrew apps from the menu panel's apps tab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Apps-Tab des Menüs räumst du Caches und Protokolle auf, beendest Apps, stoppst Prozesse, die einen Port blockieren, und aktualisierst Homebrew-Apps."
          }
        }
      }
    },
    "Some items are in use and were skipped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Objekte werden gerade benutzt und wurden übersprungen."
          }
        }
      }
    },
    "This is not an app Sonary can read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App kann Sonary nicht lesen."
          }
        }
      }
    },
    "%@ was moved to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde in den Papierkorb gelegt."
          }
        }
      }
    },
    "Could not move %@ to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht in den Papierkorb gelegt werden."
          }
        }
      }
    },
    "Homebrew could not upgrade %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew konnte %@ nicht aktualisieren."
          }
        }
      }
    }
  },
  "version": "1.0"
}