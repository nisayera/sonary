{
  "sourceLanguage": "en",
  "strings": {
    "%@ could not be copied to the Applications folder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht in den Programme-Ordner kopiert werden."
          }
        }
      }
    },
    "%@ could not be stopped. It may belong to the system.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ließ sich nicht stoppen. Vielleicht gehört der Prozess zum System."
          }
        }
      }
    },
    "%@ is in your Applications folder, and the disk image is in the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liegt jetzt in deinem Programme-Ordner, das Disk-Image im Papierkorb."
          }
        }
      }
    },
    "%@ is in your Applications folder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liegt jetzt in deinem Programme-Ordner."
          }
        }
      }
    },
    "%@ was moved to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde in den Papierkorb gelegt."
          }
        }
      }
    },
    "%@: %lld extra items, %@ in total": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld zusätzliche Objekte, insgesamt %3$@"
          }
        }
      }
    },
    "Add app…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App hinzufügen …"
          }
        }
      }
    },
    "Add folder…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner hinzufügen …"
          }
        }
      }
    },
    "App Store": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store"
          }
        }
      }
    },
    "App Store updates show here with the mas tool (brew install mas).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Store-Updates erscheinen hier mit dem Werkzeug mas (brew install mas)."
          }
        }
      }
    },
    "App caches": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Caches"
          }
        }
      }
    },
    "Apps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps"
          }
        }
      }
    },
    "Apps you keep running are left alone by Quit all.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, die weiterlaufen sollen, lässt „Alle beenden“ in Ruhe."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "Checking your apps…": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apps werden geprüft …"
          }
        }
      }
    },
    "Choose app…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App auswählen …"
          }
        }
      }
    },
    "Clean": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufräumen"
          }
        }
      }
    },
    "Clean caches and logs": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches und Protokolle aufräumen"
          }
        }
      }
    },
    "Clean caches and logs, quit or force quit apps and processes, stop processes that block a port and update Homebrew and App Store apps from the menu panel's apps tab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches und Protokolle leeren, Apps und Prozesse beenden, Prozesse stoppen, die einen Port belegen, und Homebrew- und App-Store-Apps aktualisieren – alles im Apps-Tab des Menüs."
          }
        }
      }
    },
    "Cleaning moves the files to the Trash. Apps rebuild their caches when needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufräumen legt die Dateien in den Papierkorb. Apps bauen ihre Caches bei Bedarf neu auf."
          }
        }
      }
    },
    "Could not move %@ to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht in den Papierkorb gelegt werden."
          }
        }
      }
    },
    "Delete after %lld days": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %lld Tagen löschen"
          }
        }
      }
    },
    "Disk images": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk-Images"
          }
        }
      }
    },
    "Every month": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Monat"
          }
        }
      }
    },
    "Every week": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Woche"
          }
        }
      }
    },
    "Everything Sonary manages is up to date.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was Sonary verwaltet, ist aktuell."
          }
        }
      }
    },
    "Everything installed with Homebrew is up to date.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was mit Homebrew installiert ist, ist aktuell."
          }
        }
      }
    },
    "Find a process": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozess suchen"
          }
        }
      }
    },
    "Finished ones go to %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertige landen in %@"
          }
        }
      }
    },
    "Force Quit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofort beenden"
          }
        }
      }
    },
    "Found on a mounted disk image": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem eingebundenen Image gefunden"
          }
        }
      }
    },
    "Homebrew": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew"
          }
        }
      }
    },
    "Homebrew could not install %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew konnte %@ nicht installieren."
          }
        }
      }
    },
    "Homebrew could not remove %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew konnte %@ nicht entfernen."
          }
        }
      }
    },
    "Homebrew could not upgrade %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew konnte %@ nicht aktualisieren."
          }
        }
      }
    },
    "Ignore": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorieren"
          }
        }
      }
    },
    "In the menu panel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Menü"
          }
        }
      }
    },
    "Install": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren"
          }
        }
      }
    },
    "Install Homebrew (brew.sh) to see and install updates for your apps and tools.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Homebrew (brew.sh), um Updates für deine Apps und Werkzeuge zu sehen und zu installieren."
          }
        }
      }
    },
    "Installed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert"
          }
        }
      }
    },
    "Last cleaned %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt aufgeräumt %@"
          }
        }
      }
    },
    "Logs": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokolle"
          }
        }
      }
    },
    "Move the disk image to the Trash after installing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk-Image nach der Installation in den Papierkorb legen"
          }
        }
      }
    },
    "Move to Trash": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Papierkorb legen"
          }
        }
      }
    },
    "Moved %lld old files to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld alte Dateien in den Papierkorb gelegt."
          }
        }
      }
    },
    "Moves the app and its settings, caches and data from your Library to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die App und ihre Einstellungen, Caches und Daten aus deiner Library in den Papierkorb."
          }
        }
      }
    },
    "Never": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie"
          }
        }
      }
    },
    "No app is listening on a TCP port.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine App lauscht auf einem TCP-Port."
          }
        }
      }
    },
    "Open": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen"
          }
        }
      }
    },
    "Other": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonstiges"
          }
        }
      }
    },
    "Ports": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ports"
          }
        }
      }
    },
    "Processes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozesse"
          }
        }
      }
    },
    "Quit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden"
          }
        }
      }
    },
    "Quit all": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle beenden"
          }
        }
      }
    },
    "Quit all but the front app": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle außer der vorderen App beenden"
          }
        }
      }
    },
    "Refresh": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen"
          }
        }
      }
    },
    "Remove an app completely": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine App vollständig entfernen"
          }
        }
      }
    },
    "Remove folder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner entfernen"
          }
        }
      }
    },
    "Remove repeated downloads": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelte Downloads entfernen"
          }
        }
      }
    },
    "Runs in the background and moves everything to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft im Hintergrund und legt alles in den Papierkorb."
          }
        }
      }
    },
    "Scheduled cleaning": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplantes Aufräumen"
          }
        }
      }
    },
    "Search": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen"
          }
        }
      }
    },
    "Search formulae and casks": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formeln und Casks suchen"
          }
        }
      }
    },
    "Some items are in use and were skipped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Objekte werden gerade benutzt und wurden übersprungen."
          }
        }
      }
    },
    "Some updates did not go through.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Updates sind nicht durchgelaufen."
          }
        }
      }
    },
    "Sonary moves files out of these folders to the Trash once they are old enough. Good for a messenger's downloads.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonary legt Dateien aus diesen Ordnern in den Papierkorb, sobald sie alt genug sind. Gut für die Downloads eines Messengers."
          }
        }
      }
    },
    "Sort finished ones into…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertige einsortieren in …"
          }
        }
      }
    },
    "Sort into this folder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesen Ordner einsortieren"
          }
        }
      }
    },
    "Sorted %lld finished downloads.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fertige Downloads einsortiert."
          }
        }
      }
    },
    "Sorted by CPU. Quit asks a process to end; Force Quit ends it at once and loses unsaved work.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach CPU sortiert. Beenden bittet einen Prozess aufzuhören; Sofort beenden stoppt ihn gleich, Ungesichertes geht verloren."
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen"
          }
        }
      }
    },
    "Stop sorting": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht mehr einsortieren"
          }
        }
      }
    },
    "The App Store could not update %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store konnte %@ nicht aktualisieren."
          }
        }
      }
    },
    "This is not an app Sonary can read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App kann Sonary nicht lesen."
          }
        }
      }
    },
    "Tidy up folders": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner aufräumen"
          }
        }
      }
    },
    "Uninstaller": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deinstallation"
          }
        }
      }
    },
    "Update": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren"
          }
        }
      }
    },
    "Update all": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle aktualisieren"
          }
        }
      }
    },
    "Updates": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates"
          }
        }
      }
    },
    "When a mounted image offers one app, the panel installs it into Applications and ejects the image. With this on, the downloaded file goes too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bietet ein geöffnetes Image genau eine App an, kopiert das Panel sie in den Programme-Ordner und wirft das Image aus. Ist das hier an, landet auch die geladene Datei im Papierkorb."
          }
        }
      }
    },
    "Xcode build data": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode-Build-Daten"
          }
        }
      }
    },
    "“Quit all” in the menu panel's Apps tab leaves these running.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Alle beenden“ im Apps-Tab des Menüs lässt diese weiterlaufen."
          }
        }
      }
    }
  },
  "version": "1.0"
}