{
  "sourceLanguage": "en",
  "strings": {
    "%@ is low": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist fast leer"
          }
        }
      }
    },
    "%lld min": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Min."
          }
        }
      }
    },
    "%lld percent left. Time to charge it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %lld Prozent. Zeit zum Aufladen."
          }
        }
      }
    },
    "A live picture from the front camera, for checking yourself before a call.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Livebild der Frontkamera, um vor einem Anruf nach dir selbst zu sehen."
          }
        }
      }
    },
    "A notice once a mouse, keyboard or headphones fall to 20 percent. Needs the batteries widget.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mitteilung, sobald Maus, Tastatur oder Kopfhörer auf 20 Prozent fallen. Braucht das Akkus-Widget."
          }
        }
      }
    },
    "All day": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganztägig"
          }
        }
      }
    },
    "Allow Sonary to use the camera in System Settings > Privacy & Security.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Sonary die Kamera in Systemeinstellungen > Datenschutz & Sicherheit."
          }
        }
      }
    },
    "Allow access": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff erlauben"
          }
        }
      }
    },
