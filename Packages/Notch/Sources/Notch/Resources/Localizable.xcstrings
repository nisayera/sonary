    "Show on displays without a notch": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Displays ohne Notch zeigen"
          }
        }
      }
    },
    "Draws a small island at the top centre of the main display.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt eine kleine Insel oben mittig auf dem Hauptdisplay."
          }
        }
      }
    },
    "Usage": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienung"
          }
        }
      }
    },
    "Move the pointer onto the island to open it. Click it to keep it open, click anywhere else to close it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege den Zeiger auf die Insel, um sie zu öffnen. Klicke sie an, damit sie offen bleibt, und klicke woanders hin, um sie zu schließen."
          }
        }
      }
    },
    "Music and Spotify, with play, pause and skip.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik und Spotify, mit Abspielen, Pause und Überspringen."
          }
        }
      }
    },
    "Today's remaining events. Asks for calendar access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die restlichen Termine von heute. Fragt nach Kalenderzugriff."
          }
        }
      }
    },
    "Quick countdowns with a sound at the end.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnelle Countdowns mit einem Ton am Ende."
          }
        }
      }
    },
    "Your newest downloads; click to open or drag them out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine neuesten Downloads; klicken zum Öffnen oder herausziehen."
          }
        }
      }
    },
    "Mouse, keyboard, trackpad and headphones.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maus, Tastatur, Trackpad und Kopfhörer."
          }
        }
      }
    }
  },
  "version": "1.0"
}