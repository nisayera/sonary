    "Draws a small island at the top centre of the main display.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt eine kleine Insel oben mittig auf dem Hauptdisplay."
          }
        }
      }
    },
    "Drop files here to park them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Dateien hier ab, um sie zu parken."
          }
        }
      }
    },
    "Minutes, separated by commas. Up to five.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuten, durch Kommas getrennt. Bis zu fünf."
          }
        }
      }
    },
