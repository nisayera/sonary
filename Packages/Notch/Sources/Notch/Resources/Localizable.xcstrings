    "Take off the shelf": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der Ablage nehmen"
          }
        }
      }
    },
    "The scratchpad's current note, while Tools is on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Notiz aus dem Notizblock, solange Werkzeuge an ist."
