            "state": "translated",
            "value": "Heute"
          }
        }
      }
    },
    "Today's remaining events. Asks for calendar access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die restlichen Termine von heute. Fragt nach Kalenderzugriff."
          }
        }
      }
    },
    "Turn on Sound or Display to control them here": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Ton oder Anzeige ein, um sie hier zu steuern"
          }
        }
      }
    },
    "Turn on Tools to keep notes here": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Werkzeuge ein, um hier Notizen zu führen"
          }
        }
      }
    },
    "Turn on widgets in Sonary's settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
