        }
      }
    },
    "Works in every app, also during calls.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert in jeder App, auch während Anrufen."
          }
        }
      }
    },
    "In the menu panel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Menü"
          }
        }
      }
    },
    "Switch speakers and microphones, change the volume, mute the microphone and keep your Mac awake from the menu panel's sound tab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Ton-Tab des Menüs wechselst du Lautsprecher und Mikrofone, änderst die Lautstärke, schaltest das Mikrofon stumm und hältst deinen Mac wach."
          }
        }
      }
    }
  },
  "version": "1.0"
