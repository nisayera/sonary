{
  "sourceLanguage": "en",
  "strings": {
    "1 h": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Std."
          }
        }
      }
    },
    "15 min": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "15 Min."
          }
        }
      }
    },
    "2 h": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2 Std."
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen"
          }
        }
      }
    },
    "Appears in the top right corner when something is picked up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint oben rechts, wenn etwas aufgenommen wird."
          }
        }
      }
    },
    "Awake until %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach bis %@"
          }
        }
      }
    },
    "Awake until you turn it off": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach, bis du es ausschaltest"
          }
        }
      }
    },
    "Headphones": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopfhörer"
          }
        }
      }
    },
    "Holds the stronger assertion, so an external display keeps working.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält die stärkere Sperre, damit ein externer Bildschirm weiterläuft."
          }
        }
      }
    },
    "In the menu panel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Menü"
          }
        }
      }
    },
    "Input": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabe"
          }
        }
      }
    },
    "Input level": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingangspegel"
          }
        }
      }
    },
    "Its menu says until when, and stops keep awake.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Menü zeigt, bis wann, und beendet das Wachhalten."
          }
        }
      }
    },
    "Keep awake": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach halten"
          }
        }
      }
    },
    "Keep awake while this app runs": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach bleiben, solange diese App läuft"
          }
        }
      }
    },
    "Keep the media keys from opening Music": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medientasten sollen Musik nicht öffnen"
          }
        }
      }
    },
    "Keeps the speakers from suddenly blaring.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass die Lautsprecher plötzlich losbrüllen."
          }
        }
      }
    },
    "Media keys": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medientasten"
          }
        }
      }
    },
    "Microphone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon"
          }
        }
      }
    },
    "Microphone level": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonpegel"
          }
        }
      }
    },
    "Move up": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach oben"
          }
        }
      }
    },
    "Moves it by one pixel and back every minute or so, for apps that mark you away when there is no input. Needs Accessibility.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegt ihn etwa jede Minute um ein Pixel hin und zurück, für Apps, die dich ohne Eingabe auf abwesend setzen. Braucht Bedienungshilfen."
          }
        }
      }
    },
    "Moves to the next speaker or headphones.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt zum nächsten Lautsprecher oder Kopfhörer."
          }
        }
      }
    },
    "Mute microphone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon stummschalten"
          }
        }
      }
    },
    "Mute the microphone with ⌃⌥M": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon mit ⌃⌥M stummschalten"
          }
        }
      }
    },
    "None": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine"
          }
        }
      }
    },
    "None yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine"
          }
        }
      }
    },
    "Not connected": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht verbunden"
          }
        }
      }
    },
    "Nothing is playing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es spielt nichts."
          }
        }
      }
    },
    "Nudge the pointer now and then": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiger ab und zu anstupsen"
          }
        }
      }
    },
    "Output": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabe"
          }
        }
      }
    },
    "Playing now": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt gerade"
          }
        }
      }
    },
    "Preferred devices": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevorzugte Geräte"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen"
          }
        }
      }
    },
    "Shortcuts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle"
          }
        }
      }
    },
    "Show": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen"
          }
        }
      }
    },
    "Show a cup in the menu bar while awake": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wachhalten eine Tasse in der Menüleiste zeigen"
          }
        }
      }
    },
    "Show a dot while the microphone is live": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Punkt anzeigen, während das Mikrofon aktiv ist"
          }
        }
      }
    },
    "Sonary can see which apps are playing. Setting each one's volume needs to take over the audio path, which Sonary does not do.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonary sieht, welche Apps spielen. Die Lautstärke einzeln zu setzen würde den Audio-Pfad übernehmen – das tut Sonary nicht."
          }
        }
      }
    },
    "Sonary needs Accessibility for this. Allow it under System Settings → Privacy & Security → Accessibility, then switch this off and on again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür braucht Sonary die Bedienungshilfen. Erlaube sie unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen und schalte das hier dann aus und wieder ein."
          }
        }
      }
    },
    "Sound": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton"
          }
        }
      }
    },
    "Start": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten"
          }
        }
      }
    },
    "Stay awake with the lid closed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit geschlossenem Deckel wach bleiben"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp"
          }
        }
      }
    },
    "Switch output": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabe wechseln"
          }
        }
      }
    },
    "Switch output with ⌃⌥O": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabe mit ⌃⌥O wechseln"
          }
        }
      }
    },
    "Switch speakers and microphones, change the volume, mute the microphone and keep your Mac awake from the menu panel's sound tab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Ton-Tab des Menüs wechselst du Lautsprecher und Mikrofone, änderst die Lautstärke, schaltest das Mikrofon stumm und hältst deinen Mac wach."
          }
        }
      }
    },
    "Turn the volume down when headphones are unplugged": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärke senken, wenn Kopfhörer getrennt werden"
          }
        }
      }
    },
    "Until": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis"
          }
        }
      }
    },
    "Until I turn it off": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis ich es ausschalte"
          }
        }
      }
    },
    "Volume": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärke"
          }
        }
      }
    },
    "When one of these appears, Sonary switches to it. The higher it is in the list, the more it is wanted. A device you pick by hand stays until another one from the list connects.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taucht eines dieser Geräte auf, wechselt Sonary dorthin. Je weiter oben, desto lieber. Ein Gerät, das du selbst wählst, bleibt, bis ein anderes aus der Liste verbunden wird."
          }
        }
      }
    },
    "While %@ runs": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange %@ läuft"
          }
        }
      }
    },
    "While a display is attached": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange ein Bildschirm angeschlossen ist"
          }
        }
      }
    },
    "While a player is running, Sonary passes the key to it instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange ein Player läuft, gibt Sonary die Taste an ihn weiter."
          }
        }
      }
    },
    "While plugged in": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange am Strom"
          }
        }
      }
    },
    "Works in every app, also during calls.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert in jeder App, auch während Anrufen."
          }
        }
      }
    }
  },
  "version": "1.0"
}