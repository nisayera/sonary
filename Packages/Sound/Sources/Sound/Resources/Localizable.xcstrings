{
  "sourceLanguage": "en",
  "strings": {
    "1 h": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Std."
          }
        }
      }
    },
    "15 min": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "15 Min."
          }
        }
      }
    },
    "2 h": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2 Std."
          }
        }
      }
    },
    "Appears in the top right corner when something is picked up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint oben rechts, wenn etwas aufgenommen wird."
          }
        }
      }
    },
    "Awake until %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach bis %@"
          }
        }
      }
    },
    "Awake until you turn it off": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach, bis du es ausschaltest"
          }
        }
      }
    },
    "Headphones": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopfhörer"
          }
        }
      }
    },
    "Holds the stronger assertion, so an external display keeps working.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält die stärkere Sperre, damit ein externer Bildschirm weiterläuft."
          }
        }
      }
    },
    "In the menu panel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Menü"
          }
        }
      }
    },
    "Keep awake": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach halten"
          }
        }
      }
    },
    "Keep awake while this app runs": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach bleiben, solange diese App läuft"
          }
        }
      }
    },
    "Keep the media keys from opening Music": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medientasten sollen Musik nicht öffnen"
          }
        }
      }
    },
    "Keeps the speakers from suddenly blaring.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass die Lautsprecher plötzlich losbrüllen."
          }
        }
      }
    },
    "Media keys": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medientasten"
          }
        }
      }
    },
    "Microphone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon"
          }
        }
      }
    },
    "Microphone level": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonpegel"
          }
        }
      }
    },
    "Moves to the next speaker or headphones.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt zum nächsten Lautsprecher oder Kopfhörer."
          }
        }
      }
    },
    "Mute microphone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon stummschalten"
          }
        }
      }
    },
    "Mute the microphone with ⌃⌥M": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon mit ⌃⌥M stummschalten"
          }
        }
      }
    },
    "None": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine"
          }
        }
      }
    },
    "Nothing is playing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es spielt nichts."
          }
        }
      }
    },
    "Output": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabe"
          }
        }
      }
    },
    "Playing now": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt gerade"
          }
        }
      }
    },
    "Shortcuts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle"
          }
        }
      }
    },
    "Show": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen"
          }
        }
      }
    },
    "Show a dot while the microphone is live": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Punkt anzeigen, während das Mikrofon aktiv ist"
          }
        }
      }
    },
    "Sonary can see which apps are playing. Setting each one's volume needs to take over the audio path, which Sonary does not do.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonary sieht, welche Apps spielen. Die Lautstärke einzeln zu setzen würde den Audio-Pfad übernehmen – das tut Sonary nicht."
          }
        }
      }
    },
    "Sound": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton"
          }
        }
      }
    },
    "Stay awake with the lid closed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit geschlossenem Deckel wach bleiben"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp"
          }
        }
      }
    },
    "Switch output": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabe wechseln"
          }
        }
      }
    },
    "Switch output with ⌃⌥O": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabe mit ⌃⌥O wechseln"
          }
        }
      }
    },
    "Switch speakers and microphones, change the volume, mute the microphone and keep your Mac awake from the menu panel's sound tab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Ton-Tab des Menüs wechselst du Lautsprecher und Mikrofone, änderst die Lautstärke, schaltest das Mikrofon stumm und hältst deinen Mac wach."
          }
        }
      }
    },
    "Turn the volume down when headphones are unplugged": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärke senken, wenn Kopfhörer getrennt werden"
          }
        }
      }
    },
    "Until I turn it off": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis ich es ausschalte"
          }
        }
      }
    },
    "Volume": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärke"
          }
        }
      }
    },
    "While %@ runs": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange %@ läuft"
          }
        }
      }
    },
    "While a display is attached": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange ein Bildschirm angeschlossen ist"
          }
        }
      }
    },
    "While a player is running, Sonary passes the key to it instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange ein Player läuft, gibt Sonary die Taste an ihn weiter."
          }
        }
      }
    },
    "While plugged in": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange am Strom"
          }
        }
      }
    },
    "Works in every app, also during calls.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert in jeder App, auch während Anrufen."
          }
        }
      }
    }
  },
  "version": "1.0"
}